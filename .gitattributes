* text=auto

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.svg  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary

# Repository control files
.gitattributes text eol=lf
.gitignore text eol=lf

# GitHub Pages reads this file as the literal custom domain, so a stray carriage return
# becomes part of the domain name. Pinned to LF rather than left to `text=auto`, which
# resolves differently depending on the checkout platform's core.autocrlf.
CNAME text eol=lf
